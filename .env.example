# EduCrate Production Environment Variables
# Copy values as needed into environment-specific secret managers or .env files.

# ------------------------------------------------------------------------------
# Server (server/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
MONGODB_URI=
# Use a strong, random secret (recommended 32+ chars). Never commit real values.
JWT_SECRET=
CORS_ORIGINS=
TRUST_PROXY=true

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin SDK (server-only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Use \n for line breaks when storing multiline keys in a single .env value.
FIREBASE_PRIVATE_KEY=
FIREBASE_REQUIRE_VERIFIED_EMAIL=true

# Optional admin bootstrap
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional malware scanning
NODE_CLAMSCAN_ENABLED=false
CLAMAV_SOCKET=/var/run/clamav/clamd.ctl

# ------------------------------------------------------------------------------
# Client (client/.env)
# ------------------------------------------------------------------------------
VITE_API_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# Production domain and tracking (recommended for deployment)
# ------------------------------------------------------------------------------
SITE_DOMAIN=
VITE_GA_MEASUREMENT_ID=
VITE_ADSENSE_CLIENT_ID=
