# EduCrate Server — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to version control.

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development          # set to 'production' in production deployments

# ── MongoDB ────────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (get from Atlas → Database → Connect → Drivers)
MONGODB_URI=

# ── Cloudinary ─────────────────────────────────────────────────────────────────
# Get from https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ── Admin Seeding ─────────────────────────────────────────────────────────────
# Used only by `npm run seed:admin` — minimum 12 characters enforced
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Security ───────────────────────────────────────────────────────────────────
# Set to 'true' and provide a ClamAV socket path to enable malware scanning on uploads
NODE_CLAMSCAN_ENABLED=false
CLAMAV_SOCKET=/var/run/clamav/clamd.ctl

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins in production, e.g. https://educrate.app
CORS_ORIGINS=

# ── Proxy ──────────────────────────────────────────────────────────────────────
# Set to 'true' when running behind a reverse proxy (Render, Heroku, Nginx)
TRUST_PROXY=false
