# EduCrate Client — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# API base URL (required)
# Development: leave empty or set to http://localhost:5000/api
# Production: set to your deployed API origin, e.g. https://api.educrate.app
VITE_API_URL=

# Firebase client app config — public identifiers from Firebase project settings.
# Do not place service-account/private-key values in any VITE_* variable.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Web3Forms — used by FeedbackModal to submit support/feedback messages.
# Get your access key from https://web3forms.com → My Account → Access Keys
VITE_WEB3FORMS_KEY=
